# ===================================================================
# RURAL EDUCATION PLATFORM — ENVIRONMENT VARIABLES CONFIGURATION
# ===================================================================

# Spring Profile ('dev' for local development with H2, 'prod' for production with MySQL)
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (MySQL for production)
DATABASE_URL=jdbc:mysql://localhost:3306/rural_edu_db?useSSL=false&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_secure_mysql_password
DATABASE_DRIVER=com.mysql.cj.jdbc.Driver

# JWT Authentication Secret (Must be a secure 256-bit string in production)
JWT_SECRET=YourProductionSecretKeyMustBeLongEnoughMinimum256BitsHS512Key!
JWT_EXPIRATION_MS=86400000

# CORS & Allowed Frontend Origins (Comma-separated origins for production)
FRONTEND_URL=https://rural-education-platform.vercel.app

# Cloudinary Cloud Storage Credentials (For cloud file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Configuration (for Vercel deployment)
VITE_API_URL=https://rural-education-platform-api.onrender.com/api
