# Environment Variables Configuration Example
# Copy to .env or configure in system environment / application.yml

# Database Parameters
DATABASE_URL=jdbc:mysql://localhost:3306/rural_edu_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_mysql_password_here

# JWT Authentication Secret (Must be 256 bits / 32+ characters)
JWT_SECRET=RuralEduPlatformSecretKeyForJWTTokenGeneration2026SecureKeyWithMinimum256BitsLength!
JWT_EXPIRATION_MS=86400000

# Cloud Storage Credentials (Cloudinary / S3 integration)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Upload Storage Directory (Local Fallback)
UPLOAD_DIR=./uploads
